@{
    ViewData["Title"] = "Access Denied";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="container text-center py-5">
    <h1 class="display-4">403</h1>
    <h2>Access Denied</h2>
    <p class="text-muted">
        You don't have permission to access this page.
    </p>

