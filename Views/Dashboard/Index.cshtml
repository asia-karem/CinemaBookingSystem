@model CinemaBookingSystem.ViewModels.DashboardViewModel

@{
    ViewData["Title"] = "Admin Dashboard";
    Layout = "~/Views/Shared/_AdminLayout.cshtml";
}


<div class="dashboard-page">

    <!-- ================= SIDEBAR ================= -->
    <aside class="dashboard-sidebar">
        <div class="dashboard-logo">
            <div class="logo-icon" aria-hidden="true">🎬</div>
            CINEMA<span class="logo-accent">+</span>
        </div>

        <nav class="sidebar-menu" aria-label="Admin navigation">
            <p class="sidebar-label">MAIN MENU</p>

            <a asp-area="Admin" asp-controller="Dashboard" asp-action="Index" class="dashboard-link active" aria-current="page">
                <i class="icon" aria-hidden="true">▦</i> <span>Dashboard</span>
            </a>
            <a asp-area="" asp-controller="Movies" asp-action="Index" class="dashboard-link">
                <i class="icon" aria-hidden="true">🎥</i> <span>Movies</span>
            </a>
            <a asp-area="" asp-controller="Cinemas" asp-action="Index" class="dashboard-link">
                <i class="icon" aria-hidden="true">🏢</i> <span>Cinemas</span>
            </a>
            <a asp-area="" asp-controller="Categories" asp-action="Index" class="dashboard-link">
                <i class="icon" aria-hidden="true">🎭</i> <span>Categories</span>
            </a>
            <a asp-area="" asp-controller="Bookings" asp-action="Index" class="dashboard-link">
                <i class="icon" aria-hidden="true">🎟️</i> <span>Bookings</span>
            </a>

            <p class="sidebar-label mt-4">SHORTCUTS</p>

            <a asp-area="" asp-controller="Home" asp-action="Index" target="_blank" rel="noopener noreferrer"
               class="dashboard-link">
                <i class="icon" aria-hidden="true">🌐</i> <span>Visit Website</span>
            </a>
        </nav>

        <div class="sidebar-bottom">
            <div class="admin-badge">
                <div class="status-indicator"></div>
                <div>
                    <strong>ADMIN PANEL</strong>
                    <small>v2.4 • Cinema System</small>
                </div>
            </div>
        </div>
    </aside>

    <!-- ================= MAIN CONTENT ================= -->
    <main class="dashboard-main">

        <header class="dashboard-header">
            <div>
                <span class="dashboard-eyebrow">OVERVIEW & STATS</span>
                <h1>Dashboard</h1>
                <p class="dashboard-subtitle">
                    Welcome back! Here's what's happening in your cinema today.
                </p>
            </div>

            <div class="header-actions">
                <a asp-area="" asp-controller="Movies" asp-action="Create" class="dashboard-add-button btn-primary">
                    <span class="btn-icon" aria-hidden="true">+</span> Add New Movie
                </a>
            </div>
        </header>

        <!-- STATS -->
        <section class="dashboard-stats" aria-label="Statistics">

            <div class="stat-card">
                <div class="stat-header">
                    <div class="stat-icon icon-movies" aria-hidden="true">🎬</div>
                </div>
                <div class="stat-body">
                    <p>Total Movies</p>
                    <h2>@Model.MoviesCount</h2>
                </div>
                <div class="stat-footer">Movies in library</div>
            </div>

            <div class="stat-card">
                <div class="stat-header">
                    <div class="stat-icon icon-cinemas" aria-hidden="true">🏢</div>
                </div>
                <div class="stat-body">
                    <p>Total Cinemas</p>
                    <h2>@Model.CinemasCount</h2>
                </div>
                <div class="stat-footer">Locations connected</div>
            </div>

            <div class="stat-card">
                <div class="stat-header">
                    <div class="stat-icon icon-categories" aria-hidden="true">🎭</div>
                </div>
                <div class="stat-body">
                    <p>Categories</p>
                    <h2>@Model.CategoriesCount</h2>
                </div>
                <div class="stat-footer">Genres available</div>
            </div>

            <div class="stat-card">
                <div class="stat-header">
                    <div class="stat-icon icon-showtimes" aria-hidden="true">🕒</div>
                </div>
                <div class="stat-body">
                    <p>Showtimes</p>
                    <h2>@Model.ShowtimesCount</h2>
                </div>
                <div class="stat-footer">Scheduled screenings</div>
            </div>

            <div class="stat-card highlight">
                <div class="stat-header">
                    <div class="stat-icon icon-bookings" aria-hidden="true">🎟️</div>
                </div>
                <div class="stat-body">
                    <p>Total Bookings</p>
                    <h2>@Model.BookingsCount</h2>
                </div>
                <div class="stat-footer">Recorded reservations</div>
            </div>

        </section>

        <!-- RECENT MOVIES -->
        <section class="dashboard-panel">
            <div class="panel-heading">
                <div>
                    <span class="dashboard-eyebrow">YOUR COLLECTION</span>
                    <h2>Latest Added Movies</h2>
                </div>

                <a asp-area="" asp-controller="Movies" asp-action="Index" class="panel-link">
                    View All Movies <span aria-hidden="true">→</span>
                </a>
            </div>

            @if (Model.LatestMovies.Any())
            {
                <div class="dashboard-table-wrapper">
                    <table class="dashboard-table">
                        <thead>
                            <tr>
                                <th>Movie</th>
                                <th>Category</th>
                                <th>Cinema Location</th>
                                <th>Price</th>
                                <th class="text-end">Actions</th>
                            </tr>
                        </thead>

                        <tbody>
                            @foreach (var movie in Model.LatestMovies)
                            {
                                <tr>
                                    <td>
                                        <div class="movie-table-name">
                                            <div class="poster-container">
                                                <img src="@movie.MainImg"
                                                     alt="@movie.Name"
                                                     loading="lazy"
                                                     data-fallback="/images/placeholder-poster.png" />
                                            </div>
                                            <div class="movie-info">
                                                <strong>@movie.Name</strong>
                                                <small>ID: #@movie.Id</small>
                                            </div>
                                        </div>
                                    </td>

                                    <td>
                                        <span class="badge-category">
                                            @(movie.Category?.Name ?? "Unassigned")
                                        </span>
                                    </td>

                                    <td>
                                        <div class="cinema-location">
                                            <span aria-hidden="true">📍</span> @(movie.Cinema?.Name ?? "N/A")
                                        </div>
                                    </td>

                                    <td class="movie-price">
                                        <strong>$@movie.Price.ToString("F2")</strong>
                                    </td>

                                    <td class="text-end">
                                        <div class="table-actions">
                                            <a asp-area="" asp-controller="Movies" asp-action="Edit" asp-route-id="@movie.Id"
                                               class="action-btn edit" title="Edit Movie" aria-label="Edit @movie.Name">✏️</a>
                                            <a asp-area="" asp-controller="Movies" asp-action="Details" asp-route-id="@movie.Id"
                                               class="action-btn details" title="View Details" aria-label="View details of @movie.Name">👁️</a>
                                            <a asp-area="" asp-controller="Movies" asp-action="Delete" asp-route-id="@movie.Id"
                                               class="action-btn delete" title="Delete Movie" aria-label="Delete @movie.Name">🗑️</a>
                                        </div>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>
            }
            else
            {
                <div class="dashboard-empty">
                    <div class="empty-icon" aria-hidden="true">🎬</div>
                    <h3>No Movies Found</h3>
                    <p>Your library is empty. Start adding movies to feature them on the website.</p>

                    <a asp-area="" asp-controller="Movies" asp-action="Create" class="dashboard-add-button btn-primary">
                        + Add First Movie
                    </a>
                </div>
            }
        </section>

    </main>
</div>

@section Scripts {
    <script>
        document.querySelectorAll('img[data-fallback]').forEach(img => {
            img.addEventListener('error', function () {
                this.onerror = null;
                this.src = this.dataset.fallback;
            }, { once: true });
        });
    </script>
}

