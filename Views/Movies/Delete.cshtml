@model CinemaBookingSystem.Models.Movie

@{
    ViewData["Title"] = "Delete Movie";
}

<link rel="stylesheet" href="~/css/movie-create.css" asp-append-version="true" />

<div class="container movie-create-page">
    <div class="row justify-content-center">
        <div class="col-lg-8 col-xl-7">
            <div class="movie-create-card">

                <div class="movie-create-header">
                    <h2>🗑️ Delete Movie</h2>
                    <p>Please confirm that you want to delete this movie.</p>
                </div>

                <div class="movie-create-body">

                    <div class="text-center mb-4">
                        @if (!string.IsNullOrEmpty(Model.MainImg))
                        {
                            <img src="@Model.MainImg"
                                 alt="@Model.Name"
                                 style="width:180px; max-height:250px; object-fit:cover; border-radius:12px;" />
                        }
                    </div>

                    <h5 class="movie-section-title">Movie Information</h5>

                    <div class="mb-3">
                        <label class="form-label">Movie Name</label>
                        <p class="form-control">@Model.Name</p>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Description</label>
                        <p class="form-control">@Model.Des</p>
                    </div>

                    <div class="row">
                        <div class="col-md-6 mb-3">
                            <label class="form-label">Ticket Price</label>
                            <p class="form-control">@Model.Price</p>
                        </div>

                        <div class="col-md-6 mb-3">
                            <label class="form-label">Status</label>
                            <p class="form-control">@Model.Status</p>
                        </div>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Category</label>
                        <p class="form-control">@(Model.Category?.Name ?? "N/A")</p>
                    </div>

                    <div class="mb-3">
                        <label class="form-label">Cinema</label>
                        <p class="form-control">@(Model.Cinema?.Name ?? "N/A")</p>
                    </div>

                    <hr class="movie-section-divider" />

                    <div class="alert alert-warning">
                        <strong>Warning!</strong>
                        Are you sure you want to delete this movie?
                        This action cannot be undone.
                    </div>

                    <form asp-action="Delete" asp-route-id="@Model.Id" method="post">

                        <input type="hidden" name="id" value="@Model.Id" />

                        <div class="d-flex flex-wrap gap-2">
                            <button type="submit" class="btn btn-danger">
                                Yes, Delete Movie
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-light movie-cancel-button">
                                Cancel
                            </a>
                        </div>

                    </form>

                </div>
            </div>
        </div>
    </div>
</div>
