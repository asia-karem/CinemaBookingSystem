@model IEnumerable<CinemaBookingSystem.Models.Booking>

@{
    ViewData["Title"] = "Bookings";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="text-light">Movie Bookings</h1>
            <p class="text-secondary">View all ticket reservations.</p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + New Booking
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No bookings have been made yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Customer</th>
                        <th>Email</th>
                        <th>Movie</th>
                        <th>Showtime</th>
                        <th>Tickets</th>
                        <th>Total Price</th>
                        <th>Status</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var booking in Model)
                    {
                        <tr>
                            <td>@booking.CustomerName</td>
                            <td>@booking.Email</td>
                            <td>
                                @(booking.Showtime?.Movie?.Name ?? "Unknown Movie")
                            </td>
                            <td>
                                @(booking.Showtime == null
                                    ? "N/A"
                                    : booking.Showtime.StartTime.ToString("dd MMM yyyy - hh:mm tt"))
                            </td>
                            <td>@booking.NumberOfTickets</td>
                            <td>@booking.TotalPrice.ToString("0.00")</td>
                            <td>
                                <span class="badge bg-warning text-dark">
                                    @booking.Status
                                </span>
                            </td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
