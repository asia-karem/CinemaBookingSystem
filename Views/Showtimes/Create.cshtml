@model CinemaBookingSystem.Models.Showtime

@{
    ViewData["Title"] = "Add Showtime";
    var noMovies = ViewBag.NoMovies == true;
}

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-7 col-lg-6">
            <div class="card bg-dark text-light shadow-lg border-secondary">
                <div class="card-body p-4">

                    <h1 class="h3 mb-2">Add Movie Showtime</h1>

                    <p class="text-secondary mb-4">
                        Choose a movie and schedule its screening.
                    </p>

                    <form asp-controller="Showtimes"
                          asp-action="Create"
                          method="post">

                        @Html.AntiForgeryToken()

                        <div asp-validation-summary="ModelOnly"
                             class="text-danger mb-3"></div>

                        @if (noMovies)
                        {
                            <div class="alert alert-warning">
                                No movies found. Add a movie before creating a showtime.

                                <a asp-controller="Movies"
                                   asp-action="Create"
                                   class="alert-link">
                                    Add Movie
                                </a>
                            </div>
                        }
                        else
                        {
                            <div class="mb-3">
                                <label asp-for="MovieId"
                                       class="form-label">
                                    Select Movie
                                </label>

                                <select asp-for="MovieId"
                                        asp-items="ViewBag.Movies"
                                        class="form-select bg-dark text-light border-secondary">
                                    <option value="">-- Select a movie --</option>
                                </select>

                                <span asp-validation-for="MovieId"
                                      class="text-danger"></span>
                            </div>
                        }

                        <div class="mb-3">
                            <label asp-for="StartTime"
                                   class="form-label">
                                Start Date and Time
                            </label>

                            <input asp-for="StartTime"
                                   type="datetime-local"
                                   asp-format="{0:yyyy-MM-ddTHH:mm}"
                                   class="form-control bg-dark text-light border-secondary"
                                   step="60" />

                            <span asp-validation-for="StartTime"
                                  class="text-danger"></span>
                        </div>

                        <div class="mb-4">
                            <label asp-for="AvailableSeats"
                                   class="form-label">
                                Available Seats
                            </label>

                            <input asp-for="AvailableSeats"
                                   type="number"
                                   min="1"
                                   max="500"
                                   class="form-control bg-dark text-light border-secondary" />

                            <span asp-validation-for="AvailableSeats"
                                  class="text-danger"></span>
                        </div>

                        <div class="d-flex gap-2">
                            <button type="submit"
                                    class="btn btn-primary"
                                    disabled="@noMovies">
                                Save Showtime
                            </button>

                            <a asp-action="Index"
                               class="btn btn-outline-light">
                                Cancel
                            </a>
                        </div>

                    </form>
                </div>
            </div>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />
}
