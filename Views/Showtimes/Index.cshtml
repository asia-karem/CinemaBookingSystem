@model IEnumerable<CinemaBookingSystem.Models.Showtime>

@{
    ViewData["Title"] = "Showtimes";
}

<div class="container py-5">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <h1 class="text-light">Movie Showtimes</h1>
            <p class="text-secondary">Manage your movie screening times.</p>
        </div>

        <a asp-controller="Showtimes"
           asp-action="Create"
           class="btn btn-primary">
            + Add Showtime
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-info">
            No showtimes have been added yet.
        </div>
    }
    else
    {
        <div class="table-responsive">
            <table class="table table-dark table-striped table-hover align-middle">
                <thead>
                    <tr>
                        <th>Movie</th>
                        <th>Date & Time</th>
                        <th>Available Seats</th>
                    </tr>
                </thead>
                <tbody>
                    @foreach (var item in Model)
                    {
                        <tr>
                            <td>@(item.Movie?.Name ?? "Unknown Movie")</td>
                            <td>@item.StartTime.ToString("dd MMM yyyy - hh:mm tt")</td>
                            <td>@item.AvailableSeats</td>
                        </tr>
                    }
                </tbody>
            </table>
        </div>
    }
</div>
