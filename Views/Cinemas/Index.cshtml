@model IEnumerable<CinemaBookingSystem.Models.Cinema>

@{
    ViewData["Title"] = "Cinemas";
}

<div class="container py-5">

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }
    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">
            @TempData["Success"]
        </div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">
            @TempData["Error"]
        </div>
    }

    <div class="d-flex justify-content-between align-items-center mb-4">
        <div>
            <p class="text-warning mb-2">CINEMA MANAGEMENT</p>
            <h1>Our Cinemas</h1>
            <p class="text-secondary">
                Manage cinema branches and their information.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary">
            + Add Cinema
        </a>
    </div>

    @if (Model == null || !Model.Any())
    {
        <div class="alert alert-dark border">
            No cinemas found. Add your first cinema!
        </div>
    }
    else
    {
        <div class="row g-4">
            @foreach (var cinema in Model)
            {
                <div class="col-md-6 col-lg-4">
                    <div class="card h-100 overflow-hidden">

                        @if (!string.IsNullOrEmpty(cinema.Img))
                        {
                            <img src="@cinema.Img"
                                 class="card-img-top"
                                 alt="@cinema.Name"
                                 style="height:220px; object-fit:cover;" />
                        }

                        <div class="card-body">
                            <h4>@cinema.Name</h4>

                            <p class="text-secondary">
                                @cinema.Address
                            </p>

                            @if (!string.IsNullOrWhiteSpace(cinema.Description))
                            {
                                <p>@cinema.Description</p>
                            }

                            <p class="text-warning">
                                Movies: @(cinema.Movies?.Count ?? 0)
                            </p>

                            <div class="d-flex gap-2 mt-3">
                                <a asp-action="Edit"
                                   asp-route-id="@cinema.Id"
                                   class="btn btn-warning">
                                    Edit
                                </a>

                                <form asp-action="Delete"
                                      asp-route-id="@cinema.Id"
                                      method="post"
                                      onsubmit="return confirm('Are you sure you want to delete this cinema?');">

                                    @Html.AntiForgeryToken()

                                    <button type="submit"
                                            class="btn btn-danger">
                                        Delete
                                    </button>
                                </form>
                            </div>

                        </div>
                    </div>
                </div>
            }
        </div>
    }
</div>
