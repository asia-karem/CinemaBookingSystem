@model IEnumerable<CinemaBookingSystem.Models.Category>

@{
    ViewData["Title"] = "Categories";
}


<div class="container py-5">
    <div class="d-flex flex-wrap justify-content-between align-items-center gap-3 mb-4">
        <div>
            <p class="text-warning mb-2">CINEMA MANAGEMENT</p>
            <h1>Movie Categories</h1>
            <p class="text-secondary">
                Manage your movie genres in one place.
            </p>
        </div>

        <a asp-action="Create" class="btn btn-primary px-4 py-2">
            + Add Category
        </a>
    </div>

</div>


    @foreach (var key in new[] { "Success", "Error" })
    {
        if (TempData[key] != null)
        {
            <div class="alert @(key == "Success" ? "alert-success" : "alert-danger")">
                @TempData[key]
            </div>
        }
    }

    <table class="table table-striped table-bordered">
        <thead class="table-dark">
            <tr>
                <th>ID</th>
                <th>Name</th>
                <th>Description</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var category in Model)
            {
                <tr>
                    <td>@category.Id</td>
                    <td>@category.Name</td>
                    <td>@category.Description</td>
                    <td>
                        <a asp-action="Edit"
                           asp-route-id="@category.Id"
                           class="btn btn-warning btn-sm">
                            Edit
                        </a>

                        <form asp-action="Delete"
                              asp-route-id="@category.Id"
                              method="post"
                              class="d-inline"
                              onsubmit="return confirm('Delete this category?');">
                            @Html.AntiForgeryToken()
                            <button type="submit"
                                    class="btn btn-danger btn-sm">
                                Delete
                            </button>
                        </form>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>
